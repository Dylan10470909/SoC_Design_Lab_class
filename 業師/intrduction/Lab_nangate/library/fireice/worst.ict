process FreePDK45 { 
   background_dielectric_constant 1.0
} 
# Well declarations 
#well NWELL {} 
#well PWELL {} 
 
# Diffusion Layers 
diffusion P_SOURCE_DRAIN {
   thickness    	 0.091 
   resistivity  	 20 
} 
 
diffusion N_SOURCE_DRAIN {
   thickness    	 0.091 
   resistivity  	 20 
} 
 
# Conducting Layers 
conductor poly {
   min_spacing  	 0.075 
   min_width    	 0.05 
   height   		 0.1860 
   thickness		 0.0790 
   resistivity  	 10.4
   gate_forming_layer  	 true 
} 
 
conductor metal1 {
   min_spacing  	 0.065 
   min_width    	 0.065 
   height   		 0.3440 
   thickness		 0.1210 
   resistivity  	 0.506
   gate_forming_layer  	 false 
} 
 
conductor metal2 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.5760 
   thickness		 0.1300 
   resistivity  	 0.3330
   gate_forming_layer  	 false 
} 
 
conductor metal3 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.8180 
   thickness		 0.1300 
   resistivity  	 0.3330 
   gate_forming_layer  	 false 
} 
 
conductor metal4 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.0600 
   thickness		 0.2600 
   resistivity  	 0.28
   gate_forming_layer  	 false 
} 
 
conductor metal5 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.5900 
   thickness		 0.2600 
   resistivity  	 0.28
   gate_forming_layer  	 false 
} 
 
conductor metal6 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 2.1200 
   thickness		 0.2600 
   resistivity  	 0.28 
   gate_forming_layer  	 false 
} 
 
conductor metal7 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 2.6500 
   thickness		 0.7400 
   resistivity  	 0.1 
   gate_forming_layer  	 false 
} 
 
conductor metal8 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 4.15700 
   thickness		 0.7400 
   resistivity  	 0.1 
   gate_forming_layer  	 false 
} 
 
conductor metal9 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		 5.6640 
   thickness		 1.8600 
   resistivity  	 0.04 
   gate_forming_layer  	 false 
} 
 
conductor metal10 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		9.3840 
   thickness		 1.8600 
   resistivity  	 0.04 
   gate_forming_layer  	 false 
} 
 
# dielectric Layers 
dielectric   field_base_diel {
   conformal 		   FALSE 
   height    		   0.0000 
   thickness 		   0.0930 
   dielectric_constant 	   3.9 
} 
 
dielectric   field_active_diel {
   conformal 		   FALSE 
   height    		   0.0930 
   thickness 		   0.0930 
   dielectric_constant 	   3.9 
} 
 
dielectric   poly_diel {
   conformal 		   FALSE 
   height    		   0.1860 
   thickness 		   0.1580 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal1_diel {
   conformal 		   FALSE 
   height    		   0.3440 
   thickness 		   0.2330 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal2_diel {
   conformal 		   FALSE 
   height    		   0.5770 
   thickness 		   0.2410 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal3_diel {
   conformal 		   FALSE 
   height    		   0.8180 
   thickness 		   0.2410 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal4_diel {
   conformal 		   FALSE 
   height    		   1.0590 
   thickness 		   0.5300 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal5_diel {
   conformal 		   FALSE 
   height    		   1.5890 
   thickness 		   0.5300 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal6_diel {
   conformal 		   FALSE 
   height    		   2.1190 
   thickness 		   0.5300 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal7_diel {
   conformal 		   FALSE 
   height    		   2.6490 
   thickness 		   1.5060 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal8_diel {
   conformal 		   FALSE 
   height    		   4.1550 
   thickness 		   1.5060 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal9_diel {
   conformal 		   FALSE 
   height    		   5.6610 
   thickness 		   3.7200 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal10_diel {
   conformal 		   FALSE 
   height    		   9.3810 
   thickness 		   3.7200 
   dielectric_constant 	   2.5 
} 
 
# Connect Layers 
via   CONT {
   bottom_layer  	 P_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 34.13 
} 
 
via   CONT {
   bottom_layer  	 N_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 34.13
} 
 
via   via9 {
   bottom_layer   	 metal9 
   top_layer      	 metal10 
   contact_resistance 0.666 
} 
 
via   via8 {
   bottom_layer   	 metal8 
   top_layer      	 metal9 
   contact_resistance  1.333
} 
 
via   via7 {
   bottom_layer   	 metal7 
   top_layer      	 metal8 
   contact_resistance  1.333
} 
 
via   via6 {
   bottom_layer   	 metal6 
   top_layer      	 metal7 
   contact_resistance  4
} 
 
via   via5 {
   bottom_layer   	 metal5 
   top_layer      	 metal6 
   contact_resistance 4 
} 
 
via   via4 {
   bottom_layer   	 metal4 
   top_layer      	 metal5 
   contact_resistance 4 
} 
 
via   via3 {
   bottom_layer   	 metal3 
   top_layer      	 metal4 
   contact_resistance 6.666 
} 
 
via   via2 {
   bottom_layer   	 metal2 
   top_layer      	 metal3 
   contact_resistance 6.666 
} 
 
via   via1 {
   bottom_layer   	 metal1 
   top_layer      	 metal2 
   contact_resistance 8 
} 
 
via   contact {
   bottom_layer   	 poly 
   top_layer      	 metal1 
   contact_resistance 10.666 
} 
 
