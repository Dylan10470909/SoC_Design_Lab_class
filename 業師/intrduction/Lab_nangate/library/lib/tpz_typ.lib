    cell (PADIOVDDPOC) {
        area : 6000.0000 ;
        cell_footprint : io ;
        dont_touch : true ;
        dont_use : true ;
        pad_cell : true ;
        pin(VDDIO) {
            is_pad : true ;
            direction : inout ;
            capacitance : 1 ;
            input_signal_level : VDDIO  ;
            output_signal_level : VDDIO  ;
        }
    } /* cell PADIOVDDPOC */
    cell (PADCORNER) {
        area : 40000.0000 ;
        cell_footprint : io ;
        dont_touch : true ;
        dont_use : true ;
        pad_cell : false ;
    } /* cell PADCORNER */
