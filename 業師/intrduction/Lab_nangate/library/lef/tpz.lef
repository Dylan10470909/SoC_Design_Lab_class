MACRO PADVDD
    CLASS PAD ;
    FOREIGN PADVDD 0.000 0.000  ;
    ORIGIN 0.000 0.000 ;
    SIZE 29.260 BY 199.500 ;
    SYMMETRY x y r90 ;
    SITE pad ;
    PIN VDD
        DIRECTION INOUT ;
        USE power ;
        PORT
        CLASS CORE ;
        LAYER metal2 ;
        RECT  4.000 195.000 8.000 199.500 ;
        LAYER metal1 ;
        RECT  4.000 195.000 8.000 199.500 ;
        END
        PORT
        CLASS CORE ;
        LAYER metal2 ;
        RECT  10.000 195.000 14.000 199.500 ;
        LAYER metal1 ;
        RECT  10.000 195.000 14.000 199.500 ;
        END
        PORT
        CLASS CORE ;
        LAYER metal2 ;
        RECT  16.000 195.000 20.000 199.500 ;
        LAYER metal1 ;
        RECT  16.000 195.000 20.000 199.500 ;
        END
        PORT
        CLASS CORE ;
        LAYER metal2 ;
        RECT  22.000 195.000 26.000 199.500 ;
        LAYER metal1 ;
        RECT  22.000 195.000 26.000 199.500 ;
        END
        PORT
        LAYER metal7 ;
        RECT  4.000 95 26.000 105 ;
        END
    END VDD
    OBS
        LAYER metal1 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via1 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal2 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via2 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal3 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via3 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal4 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via4 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal5 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via5 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal6 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via6 ;
        RECT  0.000 0.000 29.260 194.000 ;
    END
END PADVDD

