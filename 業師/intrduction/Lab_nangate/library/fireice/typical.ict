process FreePDK45 { 
   background_dielectric_constant 1.0
} 
# Well declarations 
#well NWELL {} 
#well PWELL {} 
 
# Diffusion Layers 
diffusion P_SOURCE_DRAIN {
   thickness    	 0.098 
   resistivity  	 15 
} 
 
diffusion N_SOURCE_DRAIN {
   thickness    	 0.098 
   resistivity  	 15 
} 
 
# Conducting Layers 
conductor poly {
   min_spacing  	 0.075 
   min_width    	 0.05 
   height   		 0.2000 
   thickness		 0.0850 
   resistivity  	 7.8 
   gate_forming_layer  	 true 
} 
 
conductor metal1 {
   min_spacing  	 0.065 
   min_width    	 0.065 
   height   		 0.3700 
   thickness		 0.1300 
   resistivity  	 0.38 
   gate_forming_layer  	 false 
} 
 
conductor metal2 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.6200 
   thickness		 0.1400 
   resistivity  	 0.25 
   gate_forming_layer  	 false 
} 
 
conductor metal3 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.8800 
   thickness		 0.1400 
   resistivity  	 0.25 
   gate_forming_layer  	 false 
} 
 
conductor metal4 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.1400 
   thickness		 0.2800 
   resistivity  	 0.21 
   gate_forming_layer  	 false 
} 
 
conductor metal5 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.7100 
   thickness		 0.2800 
   resistivity  	 0.21 
   gate_forming_layer  	 false 
} 
 
conductor metal6 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 2.2800 
   thickness		 0.2800 
   resistivity  	 0.21 
   gate_forming_layer  	 false 
} 
 
conductor metal7 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 2.8500 
   thickness		 0.8000 
   resistivity  	 0.075 
   gate_forming_layer  	 false 
} 
 
conductor metal8 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 4.4700 
   thickness		 0.8000 
   resistivity  	 0.075 
   gate_forming_layer  	 false 
} 
 
conductor metal9 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		 6.0900 
   thickness		 2.0000 
   resistivity  	 0.03 
   gate_forming_layer  	 false 
} 
 
conductor metal10 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		10.0900 
   thickness		 2.0000 
   resistivity  	 0.03 
   gate_forming_layer  	 false 
} 
 
# dielectric Layers 
dielectric   field_base_diel {
   conformal 		   FALSE 
   height    		   0.0000 
   thickness 		   0.1000 
   dielectric_constant 	   3.9 
} 
 
dielectric   field_active_diel {
   conformal 		   FALSE 
   height    		   0.1000 
   thickness 		   0.1000 
   dielectric_constant 	   3.9 
} 
 
dielectric   poly_diel {
   conformal 		   FALSE 
   height    		   0.2000 
   thickness 		   0.1700 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal1_diel {
   conformal 		   FALSE 
   height    		   0.3700 
   thickness 		   0.2500 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal2_diel {
   conformal 		   FALSE 
   height    		   0.6200 
   thickness 		   0.2600 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal3_diel {
   conformal 		   FALSE 
   height    		   0.8800 
   thickness 		   0.2600 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal4_diel {
   conformal 		   FALSE 
   height    		   1.1400 
   thickness 		   0.5700 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal5_diel {
   conformal 		   FALSE 
   height    		   1.7100 
   thickness 		   0.5700 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal6_diel {
   conformal 		   FALSE 
   height    		   2.2800 
   thickness 		   0.5700 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal7_diel {
   conformal 		   FALSE 
   height    		   2.8500 
   thickness 		   1.6200 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal8_diel {
   conformal 		   FALSE 
   height    		   4.4700 
   thickness 		   1.6200 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal9_diel {
   conformal 		   FALSE 
   height    		   6.0900 
   thickness 		   4.0000 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal10_diel {
   conformal 		   FALSE 
   height    		  10.0900 
   thickness 		   4.0000 
   dielectric_constant 	   2.5 
} 
 
# Connect Layers 
via   CONT {
   bottom_layer  	 P_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 25.6 
} 
 
via   CONT {
   bottom_layer  	 N_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 25.6 
} 
 
via   via9 {
   bottom_layer   	 metal9 
   top_layer      	 metal10 
   contact_resistance 0.5 
} 
 
via   via8 {
   bottom_layer   	 metal8 
   top_layer      	 metal9 
   contact_resistance 1 
} 
 
via   via7 {
   bottom_layer   	 metal7 
   top_layer      	 metal8 
   contact_resistance 1 
} 
 
via   via6 {
   bottom_layer   	 metal6 
   top_layer      	 metal7 
   contact_resistance 3 
} 
 
via   via5 {
   bottom_layer   	 metal5 
   top_layer      	 metal6 
   contact_resistance 3 
} 
 
via   via4 {
   bottom_layer   	 metal4 
   top_layer      	 metal5 
   contact_resistance 3 
} 
 
via   via3 {
   bottom_layer   	 metal3 
   top_layer      	 metal4 
   contact_resistance 5 
} 
 
via   via2 {
   bottom_layer   	 metal2 
   top_layer      	 metal3 
   contact_resistance 5 
} 
 
via   via1 {
   bottom_layer   	 metal1 
   top_layer      	 metal2 
   contact_resistance 6 
} 
 
via   contact {
   bottom_layer   	 poly 
   top_layer      	 metal1 
   contact_resistance 8 
} 
 
