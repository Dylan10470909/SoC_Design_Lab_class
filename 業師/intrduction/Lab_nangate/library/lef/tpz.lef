
SITE pad
    SYMMETRY x y r90 ;
    CLASS pad ;
    SIZE 0.005 BY 199.500 ;
END pad 

SITE corner
    SYMMETRY x y r90 ;
    CLASS pad ;
    SIZE 199.500 BY 199.500 ;
END corner

MACRO PADIN
    CLASS PAD ;
    FOREIGN PADIN 0.000 0.000  ;
    ORIGIN 0.000 0.000 ;
    SIZE 29.260 BY 199.500 ;
    SYMMETRY x y r90 ;
    SITE pad ;
    PIN PAD
        DIRECTION INPUT ;
        PORT
        LAYER metal7 ;
        RECT  4.000 95 26.000 105 ;
        END
    END PAD
    PIN C
        DIRECTION OUTPUT ;
        PORT
        LAYER metal1 ;
        RECT  26 199.000 27 199.500 ;
        LAYER metal2 ;
        RECT  26 199.000 27 199.500 ;
        LAYER metal3 ;
        RECT  26 199.000 27 199.500 ;
        LAYER metal4 ;
        RECT  26 199.000 27 199.500 ;
        LAYER metal5 ;
        RECT  26 199.000 27 199.500 ;
        END
    END C
    OBS
        LAYER metal1 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via1 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal2 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER via2 ;
        RECT  0.000 0.000 29.260 194.000 ;
        LAYER metal3 ;
        RECT  0.000 0.000 29.260 194.000 ;
