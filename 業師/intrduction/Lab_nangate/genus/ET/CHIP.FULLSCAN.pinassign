assign pin=TEST_MODE 	test_function= +TI; 	# test_mode
assign pin=RESET_ 	test_function= +TI; 	# test_mode
assign pin=SCAN_EN 	test_function= +SE; 	# shift_enable
assign pin=CLK 	test_function= -ES; 	
assign pin=X[0] 	test_function= SI0;
assign pin=Z[0] 	test_function= SO0;
assign pin=X[1] 	test_function= SI1;
assign pin=Z[1] 	test_function= SO1;
assign pin=X[2] 	test_function= SI2;
assign pin=Z[2] 	test_function= SO2;
