process FreePDK45 { 
   background_dielectric_constant 1.0
} 
# Well declarations 
#well NWELL {} 
#well PWELL {} 
 
# Diffusion Layers 
diffusion P_SOURCE_DRAIN {
   thickness    	 0.105
   resistivity  	 11.25 
} 
 
diffusion N_SOURCE_DRAIN {
   thickness    	 0.105 
   resistivity  	 11.25 
} 
 
# Conducting Layers 
conductor poly {
   min_spacing  	 0.075 
   min_width    	 0.05 
   height   		 0.2150 
   thickness		 0.0910 
   resistivity  	 5.85
   gate_forming_layer  	 true 
} 
 
conductor metal1 {
   min_spacing  	 0.065 
   min_width    	 0.065 
   height   		 0.3980 
   thickness		 0.1398 
   resistivity  	 0.295
   gate_forming_layer  	 false 
} 
 
conductor metal2 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.6666 
   thickness		 0.1505 
   resistivity  	 0.1880
   gate_forming_layer  	 false 
} 
 
conductor metal3 {
   min_spacing  	 0.07 
   min_width    	 0.07 
   height   		 0.9460 
   thickness		 0.1500 
   resistivity  	 0.1875 
   gate_forming_layer  	 false 
} 
 
conductor metal4 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.2260 
   thickness		 0.3010 
   resistivity  	 0.1575 
   gate_forming_layer  	 false 
} 
 
conductor metal5 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 1.8380 
   thickness		 0.3010 
   resistivity  	 0.1575 
   gate_forming_layer  	 false 
} 
 
conductor metal6 {
   min_spacing  	 0.14 
   min_width    	 0.14 
   height   		 2.4520 
   thickness		 0.3010 
   resistivity  	 0.1575 
   gate_forming_layer  	 false 
} 
 
conductor metal7 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 3.06500 
   thickness		 0.8600 
   resistivity  	 0.056 
   gate_forming_layer  	 false 
} 
 
conductor metal8 {
   min_spacing  	 0.4 
   min_width    	 0.4 
   height   		 4.8060 
   thickness		 0.8600 
   resistivity  	 0.056 
   gate_forming_layer  	 false 
} 
 
conductor metal9 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		 6.5480 
   thickness		 2.1500 
   resistivity  	 0.023 
   gate_forming_layer  	 false 
} 
 
conductor metal10 {
   min_spacing  	 0.8 
   min_width    	 0.8 
   height   		10.8490 
   thickness		 2.1500 
   resistivity  	 0.023 
   gate_forming_layer  	 false 
} 
 
# dielectric Layers 
dielectric   field_base_diel {
   conformal 		   FALSE 
   height    		   0.0000 
   thickness 		   0.1070 
   dielectric_constant 	   3.9 
} 
 
dielectric   field_active_diel {
   conformal 		   FALSE 
   height    		   0.1070 
   thickness 		   0.1070 
   dielectric_constant 	   3.9 
} 
 
dielectric   poly_diel {
   conformal 		   FALSE 
   height    		   0.2140 
   thickness 		   0.1830 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal1_diel {
   conformal 		   FALSE 
   height    		   0.3970 
   thickness 		   0.2690 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal2_diel {
   conformal 		   FALSE 
   height    		   0.6660 
   thickness 		   0.2800 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal3_diel {
   conformal 		   FALSE 
   height    		   0.9460 
   thickness 		   0.2800 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal4_diel {
   conformal 		   FALSE 
   height    		   1.2260 
   thickness 		   0.6130 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal5_diel {
   conformal 		   FALSE 
   height    		   1.8390 
   thickness 		   0.6130 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal6_diel {
   conformal 		   FALSE 
   height    		   2.4520 
   thickness 		   0.6130 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal7_diel {
   conformal 		   FALSE 
   height    		   3.0650 
   thickness 		   1.7420 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal8_diel {
   conformal 		   FALSE 
   height    		   4.8070 
   thickness 		   1.7420 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal9_diel {
   conformal 		   FALSE 
   height    		   6.5490 
   thickness 		   4.3010 
   dielectric_constant 	   2.5 
} 
 
dielectric   metal10_diel {
   conformal 		   FALSE 
   height    		  10.8500 
   thickness 		   4.3010 
   dielectric_constant 	   2.5 
} 
 
# Connect Layers 
via   CONT {
   bottom_layer  	 P_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 19.2 
} 
 
via   CONT {
   bottom_layer  	 N_SOURCE_DRAIN 
   top_layer     	 metal1 
   contact_resistance  	 19.2 
} 
 
via   via9 {
   bottom_layer   	 metal9 
   top_layer      	 metal10 
   contact_resistance 0.375 
} 
 
via   via8 {
   bottom_layer   	 metal8 
   top_layer      	 metal9 
   contact_resistance 0.75 
} 
 
via   via7 {
   bottom_layer   	 metal7 
   top_layer      	 metal8 
   contact_resistance 0.75 
} 
 
via   via6 {
   bottom_layer   	 metal6 
   top_layer      	 metal7 
   contact_resistance 2.25 
} 
 
via   via5 {
   bottom_layer   	 metal5 
   top_layer      	 metal6 
   contact_resistance 2.25 
} 
 
via   via4 {
   bottom_layer   	 metal4 
   top_layer      	 metal5 
   contact_resistance 2.25 
} 
 
via   via3 {
   bottom_layer   	 metal3 
   top_layer      	 metal4 
   contact_resistance 3.75 
} 
 
via   via2 {
   bottom_layer   	 metal2 
   top_layer      	 metal3 
   contact_resistance 3.75 
} 
 
via   via1 {
   bottom_layer   	 metal1 
   top_layer      	 metal2 
   contact_resistance 4.5 
} 
 
via   contact {
   bottom_layer   	 poly 
   top_layer      	 metal1 
   contact_resistance 6 
} 
 
