create_library_set -name lib_max -timing {../../library/lib/NangateOpenCellLibrary_slow.lib ../../library/memory/rf_2p_hse_nldm_ss_0p81v_0p81v_125c_syn.lib ../../library/lib/tpz_slow.lib} -si {../../library/celtic/slow.cdb}
create_library_set -name lib_min -timing {../../library/lib/NangateOpenCellLibrary_fast.lib ../../library/memory/rf_2p_hse_nldm_ff_0p99v_0p99v_m40c_syn.lib ../../library/lib/tpz_fast.lib} -si {../../library/celtic/fast.cdb}
