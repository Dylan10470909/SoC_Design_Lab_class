MACRO BONDINNER
    #CLASS BLOCK ;
    CLASS PAD ;
    FOREIGN BONDINNER 0.000 0.000  ;
    ORIGIN 0.000 0.000 ;
    SIZE 29.260 BY 100 ;
    SYMMETRY x y r90 ;
    OBS
        #LAYER metal7 ;
        #RECT  4.000 95.000 26.000 105.000 ;
        LAYER metal8 ;
        RECT  0.000 0.000 29.260 100.000 ; 
        LAYER metal9 ;
        RECT  -10.000 10.000 40.000 60.000 ; 
     END
END BONDINNER

MACRO BONDOUTER
    #CLASS BLOCK ;
